# Read by brew itself on every run, whichever shell or script starts it, so
# these stay out of the shell environment. Lines are taken literally: no
# quotes, no variable expansion.
HOMEBREW_NO_ENV_HINTS=true
HOMEBREW_GITHUB_API_TOKEN={{ onepasswordRead "op://dotfiles/homebrew/HOMEBREW_GITHUB_API_TOKEN" }}
HOMEBREW_DOWNLOAD_CONCURRENCY=auto
HOMEBREW_BUNDLE_FILE_GLOBAL={{ .chezmoi.homeDir }}/.config/homebrew/Brewfile
