################################
### machine information      ###
################################
{{- $machine := promptChoiceOnce . "machine" "machine name" (list "personal" "work" "mini") }}

################################
### chezmoi data             ###
################################
data:
  machine: {{ $machine }}

{{- if eq .chezmoi.os "darwin" }}
  {{- if eq .chezmoi.arch "arm64" }}
  brewprefix: /opt/homebrew
  {{- else if eq .chezmoi.arch "amd64" }}
  brewprefix: /usr/local
  {{- end }}
{{- end }}

################################
### chezmoi config           ###
################################
sourceDir: {{ .chezmoi.homeDir }}/projects/dotfiles

format: yaml
pager: delta
diff:
  exclude: ["scripts"]
onepassword:
  mode: service
