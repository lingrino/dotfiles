#!/usr/bin/env fish

set -l prepend (path filter -d -- \
    {{ .chezmoi.homeDir }}/.local/bin \
    {{ .chezmoi.homeDir }}/.bun/bin \
    {{ .chezmoi.homeDir }}/.cargo/bin \
    {{ .brewprefix }}/opt/rustup/bin \
    {{ .chezmoi.homeDir }}/go/bin \
{{- if eq .machine "work" }}
    {{ .brewprefix }}/share/google-cloud-sdk/bin \
    {{ .chezmoi.homeDir }}/.proto/shims \
    {{ .chezmoi.homeDir }}/.proto/bin \
{{- end }}
    {{ .brewprefix }}/bin \
    {{ .chezmoi.homeDir }}/.orbstack/bin)

set -l system
for dir in /usr/local/bin /usr/local/sbin /bin /sbin /usr/bin /usr/sbin
    contains -- $dir $PATH; or set -a system $dir
end
set -q system[1]; and set system (path filter -d -- $system)

set -l rest $PATH
for dir in $prepend
    set -l i (contains -i -- $dir $rest); and set -e rest[$i]
end

set -gx PATH $prepend $system $rest
{{- if eq .machine "work" }}

# proto
set -gx PROTO_HOME {{ .chezmoi.homeDir }}/.proto
{{- end }}
