#!/usr/bin/env fish

# system paths
fish_add_path --path --prepend /bin /sbin /usr/bin /usr/sbin
fish_add_path --path --prepend /usr/local/bin /usr/local/sbin

# homebrew
fish_add_path --path --prepend --move {{ .brewprefix }}/bin

# proto
set -gx PROTO_HOME {{ .chezmoi.homeDir }}/.proto
fish_add_path --path --prepend --move $PROTO_HOME/shims $PROTO_HOME/bin

# google cloud sdk
fish_add_path --path --prepend {{ .brewprefix }}/share/google-cloud-sdk/bin

# go
fish_add_path --path --prepend {{ .chezmoi.homeDir }}/go/bin

# cargo/rust
fish_add_path --path --prepend {{ .chezmoi.homeDir }}/.cargo/bin

# bun
fish_add_path --path --prepend {{ .chezmoi.homeDir }}/.bun/bin

# ghostty
if set -q GHOSTTY_BIN_DIR
    fish_add_path --path --prepend $GHOSTTY_BIN_DIR
end

# home local bin
fish_add_path --path --prepend {{ .chezmoi.homeDir }}/.local/bin
