#!/usr/bin/env fish

# hydro prompt
# https://github.com/jorgebucaran/hydro

set -g hydro_symbol_prompt ❯
set -g hydro_symbol_git_dirty •
set -g hydro_symbol_git_ahead ↑
set -g hydro_symbol_git_behind ↓
set -g hydro_cmd_duration_threshold 300
set -g fish_prompt_pwd_dir_length 50

set -g _hydro_color_normal (set_color normal)
set -g _hydro_color_pwd (set_color cyan)
set -g _hydro_color_git (set_color magenta)
set -g _hydro_color_error (set_color $fish_color_error)
set -g _hydro_color_prompt (set_color green)
set -g _hydro_color_duration (set_color yellow)
set -g _hydro_color_aws (set_color FF9900)
set -g _hydro_color_separator (set_color brblack)
{{- if eq .machine "work" }}
set -g _hydro_color_kube (set_color 60A5FA)
{{- end }}

set -g _hydro_status_line
set -g _hydro_symbol $_hydro_color_prompt$hydro_symbol_prompt
set -g _hydro_cmd_duration
set -g _hydro_git _hydro_git_$fish_pid

# print newline before prompt
function _hydro_newline --on-event fish_postexec
    echo
end

function $_hydro_git --on-variable $_hydro_git
    commandline --function repaint
end

function _hydro_pwd --on-variable PWD
    set -l git_root $PWD
    while not test -e $git_root/.git
        if test $git_root = /
            set git_root
            break
        end
        set git_root (path dirname -- $git_root)
    end

    if set -q git_root[1]
        set -e _hydro_skip_git_prompt
    else
        set -g _hydro_skip_git_prompt
    end

    set -l git_base (string replace --all --regex -- "^.*/" "" "$git_root")
    set -g _hydro_pwd (
        string replace --ignore-case -- ~ \~ $PWD |
        string replace -- "/$git_base/" /:/ |
        string replace --regex --all -- "(\.?[^/]{$fish_prompt_pwd_dir_length})[^/]*/" "\$1/" |
        string replace -- : "$git_base" |
        string replace --regex -- '([^/]+)$' "\x1b[1m\$1\x1b[22m" |
        string replace --regex --all -- '(?!^/$)/|^$' "\x1b[2m/\x1b[22m"
    )
end

function _hydro_postexec --on-event fish_postexec
    set -l last_status $pipestatus
    set -g _hydro_status_line
    set -g _hydro_symbol $_hydro_color_prompt$hydro_symbol_prompt

    for code in $last_status
        if test $code -ne 0
            set -g _hydro_status_line "$_hydro_color_error| $last_status "
            set -g _hydro_symbol $_hydro_color_prompt$_hydro_color_error$hydro_symbol_prompt
            break
        end
    end

    if test "$CMD_DURATION" -lt $hydro_cmd_duration_threshold
        set -g _hydro_cmd_duration
        return
    end

    set -l secs (math --scale=1 $CMD_DURATION/1000 % 60)
    set -l mins (math --scale=0 $CMD_DURATION/60000 % 60)
    set -l hours (math --scale=0 $CMD_DURATION/3600000)

    set -l out
    test $hours -gt 0 && set -a out $hours"h"
    test $mins -gt 0 && set -a out $mins"m"
    test $secs -gt 0 && set -a out $secs"s"

    set -g _hydro_cmd_duration "$out "
end

{{- if eq .machine "work" }}

function _hydro_kube_show
    test "$_hydro_kube[1]" = "$_hydro_kube_key"; or return 1
    set -g _hydro_kube_segment
    set -q _hydro_kube[3]
    and set -g _hydro_kube_segment "$_hydro_color_kube$_hydro_kube[2]$_hydro_color_normal:$_hydro_color_kube$_hydro_kube[3]$_hydro_color_normal"
end

function _hydro_kube_changed --on-variable _hydro_kube
    _hydro_kube_show; and commandline --function repaint
end

function _hydro_kube_update
    set -l files ~/.kube/config
    test -n "$KUBECONFIG"; and set files (string split : -- $KUBECONFIG)
    set -l key (string join -- ' ' "$KUBECONFIG" (path mtime -- (path filter --perm read -- $files)))
    test "$key" = "$_hydro_kube_key"; and return

    set -g _hydro_kube_key $key
    set -g _hydro_kube_segment
    _hydro_kube_show; and return

    fish --private --command '
        set -l out
        command -q kubectl
        and set out (command kubectl config view --minify --output "jsonpath={.current-context}{\"\n\"}{..namespace}" 2>/dev/null)
        if test -n "$out[1]"
            set out[1] (string replace --regex -- "^arn:aws:eks:[^:]+:[^:]+:cluster/" "" $out[1])
            test -n "$out[2]"; or set out[2] N/A
        end
        set --universal _hydro_kube $argv[1] $out[1..2]
    ' $key &
end
{{- end }}

function _hydro_prompt --on-event fish_prompt
    set -q _hydro_pwd; or _hydro_pwd
{{- if eq .machine "work" }}
    _hydro_kube_update
{{- end }}

    if set -q _hydro_last_pid[1]; and jobs --query $_hydro_last_pid
        command kill $_hydro_last_pid 2>/dev/null
    end

    if set -q _hydro_skip_git_prompt
        set -q $_hydro_git; and set -e $_hydro_git
        return
    end

    fish --private --command "
        set -l var $_hydro_git
        if set -l lines (command git --no-optional-locks status --porcelain=v2 --branch 2>/dev/null)
            set -l branch (string replace --filter -- '# branch.head ' '' \$lines)
            if test \"\$branch\" = '(detached)'
                set branch (
                    command git describe --tags --exact-match HEAD 2>/dev/null ||
                    command git rev-parse --short HEAD 2>/dev/null | string replace --regex -- '(.+)' '@\$1'
                )
            end

            set -l info
            string match --quiet --invert -- '#*' \$lines && set info $hydro_symbol_git_dirty

            set -l upstream
            if set -l ab (string match --regex --groups-only -- '^# branch\.ab \+(\d+) -(\d+)\$' \$lines)
                test \$ab[1] -gt 0 && set upstream \" $hydro_symbol_git_ahead\$ab[1]\"
                test \$ab[2] -gt 0 && set upstream \"\$upstream $hydro_symbol_git_behind\$ab[2]\"
            end

            set -l value \"\$branch\$info\$upstream \"
            test \"\$\$var\" = \"\$value\" || set --universal \$var \$value
        else if set -q \$var
            set --erase --universal \$var
        end

        set -l vars (set --universal --names | string match --regex -- '^_hydro_git_\d+\$')
        if test (count \$vars) -gt 32
            for v in \$vars
                command kill -0 (string sub --start 12 -- \$v) 2>/dev/null || set --erase --universal \$v
            end
        end
    " &

    set -g _hydro_last_pid $last_pid
end

function _hydro_fish_exit --on-event fish_exit
    set -e $_hydro_git
end

function fish_prompt --description 'hydro with cloud context'
    set -l left "$_hydro_color_normal$_hydro_color_pwd$_hydro_pwd$_hydro_color_normal $_hydro_color_git$$_hydro_git$_hydro_color_normal$_hydro_color_duration$_hydro_cmd_duration$_hydro_color_normal$_hydro_status_line$_hydro_color_normal"

    set -l segments
    set -l aws_profile $AWS_PROFILE
    test -z "$aws_profile"; and set aws_profile $AWS_DEFAULT_PROFILE
    test -n "$aws_profile"; and set -a segments $_hydro_color_aws$aws_profile
{{- if eq .machine "work" }}
    test -n "$_hydro_kube_segment"; and set -a segments $_hydro_kube_segment
{{- end }}

    if set -q segments[1]
        set -l right (string join -- "$_hydro_color_separator │ " $segments)$_hydro_color_normal
        set -l padding (math $COLUMNS - (string length --visible -- "$left") - (string length --visible -- "$right"))
        if test $padding -gt 0
            printf '%s%*s%s\n' "$left" $padding '' "$right"
        else
            printf '%s\n' "$left"
        end
    else
        printf '%s\n' "$left"
    end

    printf '%s ' "$_hydro_symbol$_hydro_color_normal"
end
