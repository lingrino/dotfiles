[alias]
  a = "!f() { git add -A && git commit -m \"${*}\" && git push; }; f"
  br = branch
  bs = branch -a
  cl = clone
  cm = commit
  co = checkout
  db = "!f() { git branch -vv | grep ': gone]'| grep -v \"*\" | awk '{ print $1; }' | xargs git branch -D; }; f"
  df = diff
  lg = log --graph --pretty=format:'%Cred%h%Creset %an: %s - %Creset %C(yellow)%d%Creset %Cgreen(%cr)%Creset' --abbrev-commit --date=relative
  ms = !git co $(git symbolic-ref refs/remotes/origin/HEAD | sed 's@^refs/remotes/origin/@@') && git pull && git db
  nb = "!f() { b=sean/${1}; git checkout -b $b && git push --set-upstream origin $b:$b; }; f"
  pc = "!gh pr create --web"
  pv = "!gh pr view --web"
  ps = push
  pl = pull
  rr = "!for pr in $(gh search prs --owner=lingrino --review-requested=@me --state=open --app=renovate --archived=false --json url -q '.[].url'); do gh pr review "${pr}" --approve && gh pr merge "${pr}" --squash --auto; done"
  rv = "!gh repo view --web"
  sd = !git stash && git stash drop
  st = status
  t = "!f() { git tag -a \"${1}\" -m \"${*:2}\" && git push origin \"${1}\"; }; f"
  ts = tag -l

  aliases = config --get-regexp alias
  branches = branch -a
  remotes = remote -v
  tags = tag -l
[apply]
  whitespace = nowarn
[color]
  diff = auto
  status = auto
  branch = auto
  ui = true
[commit]
  gpgSign = true
[core]
  excludesfile = {{ .chezmoi.homeDir }}/.config/git/ignore
  editor = $GIT_EDITOR
  pager = hunk pager
  fsmonitor = true
  untrackedCache = true
[credential]
  helper = osxkeychain
[difftool]
  prompt = false
[fetch]
  prune = true
[gpg]
  format = ssh
[gpg "ssh"]
  allowedSignersFile = ~/.ssh/allowed_signers
[help]
  autocorrect = 1
[init]
  defaultBranch = main
[merge]
  conflictstyle = zdiff3
[mergetool]
  keepBackup = false
[pack]
  useSparse = true
[protocol]
  version = 2
[pull]
  rebase = false
[push]
  default = simple
  followTags = true
[user]
  name = Sean Lingren
  email = sean@lingren.com
{{- if eq .machine "mini" }}
  signingkey = ~/.ssh/mini.pub
{{- else }}
  signingkey = ~/.ssh/personal.pub
{{- end }}
{{- if eq .machine "work" }}
[includeIf "gitdir:~/projects/work/"]
  path = ~/.config/git/config-work
{{- end }}
