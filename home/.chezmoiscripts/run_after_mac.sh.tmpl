#!/usr/bin/env sh
set -euo pipefail

# doc on available options
# https://git.herrbischoff.com/awesome-macos-command-line/about/

# keyboard
defaults write -g ApplePressAndHoldEnabled -bool false
defaults write -g KeyRepeat 2
defaults write -g InitialKeyRepeat 12

mkdir -p '{{ .chezmoi.homeDir }}/Library/KeyBindings'
tee {{ .chezmoi.homeDir }}/Library/KeyBindings/DefaultKeyBinding.dict >/dev/null <<EOF
{
  "\UF729"  = moveToBeginningOfLine:; // home
  "\UF72B"  = moveToEndOfLine:; // end
  "$\UF729" = moveToBeginningOfLineAndModifySelection:; // shift-home
  "$\UF72B" = moveToEndOfLineAndModifySelection:; // shift-end
  "^\UF729" = moveToBeginningOfDocument:; // ctrl-home
  "^\UF72B" = moveToEndOfDocument:; // ctrl-end
  "^$\UF729" = moveToBeginningOfDocumentAndModifySelection:; // ctrl-shift-home
  "^$\UF72B" = moveToEndOfDocumentAndModifySelection:; // ctrl-shift-end
}
EOF

# The settings below need sudo to change but not to read, so each one is only
# set (with sudo) when it differs from what we want.

# dns - https://1.1.1.1/dns/
DNS_SERVERS="1.1.1.1 1.0.0.1 2606:4700:4700::1111 2606:4700:4700::1001"
set_dns() {
    CURRENT=$(networksetup -getdnsservers "$1" | tr '\n' ' ')
    if [ "${CURRENT}" != "${DNS_SERVERS} " ]; then
        # shellcheck disable=SC2086 # split the server list into arguments
        sudo networksetup -setdnsservers "$1" ${DNS_SERVERS}
        echo "mac: set $1 dns"
    fi
}
set_dns Wi-Fi
{{- if eq .machine "mini" }}
set_dns Ethernet
{{- end }}

# computer names
set_name() {
    if [ "$(scutil --get "$1" 2>/dev/null || true)" != "$2" ]; then
        sudo scutil --set "$1" "$2"
        echo "mac: set $1 to $2"
    fi
}
set_name HostName '{{ .machine }}.local'
set_name ComputerName '{{ .machine }}'
set_name LocalHostName '{{ .machine }}'
