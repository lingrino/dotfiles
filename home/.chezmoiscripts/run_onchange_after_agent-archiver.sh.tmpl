#!/usr/bin/env bash
set -euo pipefail

# Reloads the agent-archiver launchd agent. chezmoi writes the plist itself;
# the hash below makes this script rerun whenever the plist changes.
# plist: {{ include "private_Library/private_LaunchAgents/com.lingrino.agent-archiver.plist.tmpl" | sha256sum }}

LABEL="com.lingrino.agent-archiver"

launchctl bootout "gui/$(id -u)/${LABEL}" 2>/dev/null || true
launchctl bootstrap "gui/$(id -u)" "${HOME}/Library/LaunchAgents/${LABEL}.plist"
